on init
    wait /sys/devices/platform/11110000.usb/11110000.dwc3/driver 10
    setprop sys.usb.controller "11110000.dwc3"
    setprop sys.usb.configfs 1

on init && property:ro.debuggable=1 && property:ro.boot.mode=recovery
    start recovery-console

service recovery-console /system/bin/sh
    class core
    console
    disabled
    user root
    group root shell log readproc
    seclabel u:r:su:s0
    setenv HOSTNAME console

service keymint /vendor/bin/hw/android.hardware.security.keymint-service
    class hal
    user root
    group root
    socket keymint stream 0666 root root

service gatekeeper /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    class hal
    user root
    group root

on fs && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/configs/b.1/MaxPower 900
